# Non-secret defaults. Copy to .env for local development if needed.
PORT=3002
HOST=0.0.0.0
ENABLE_LIVE_SCRAPING=false
CHROMIUM_PATH=/usr/bin/chromium
# This workspace's Chromium sandbox cannot run; use 0 on a host with a working sandbox.
CHROMIUM_NO_SANDBOX=1
# DATA_DIR=/path/to/private/persistent/data
# For production, configure NODE_ENV=production and an exact HTTPS APP_ORIGIN.
# Inject CREDENTIAL_KEY through a secret manager: base64 of 32 random bytes.
# Never commit a live key or bank credentials.
